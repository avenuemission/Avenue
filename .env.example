# Copy to .env.local and fill in. Never commit .env.local.
# Full table (where each is used, secret or public, build or runtime):
# docs/deployment.md

# Supabase project URL. Public. Needed at build and at runtime.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (publishable) key. Public. Browser sign-in only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role (secret) key. SECRET. Server code, the email
# function, and the build (public pages read content at build time).
SUPABASE_SERVICE_ROLE_KEY=

# Admin passcode typed on /leaders/admin. SECRET.
ADMIN_API_KEY=

# Gmail account and app password for every email the site sends. SECRET.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Base URL for links inside leader emails. Defaults to
# https://www.avenuemission.com when empty.
AVENUE_SITE_URL=
# The hourly leader email function sends only when this is exactly "false".
# Leave it empty locally: anything else is a dry run.
LEADER_EMAILS_DRY_RUN=

# OpenAI key for the APEST results and the workshop AI routes. SECRET.
OPENAI_API_KEY=
# Google Calendar API key for /api/calendar-events. SECRET.
GOOGLE_CALENDAR_API_KEY=
# Google Maps key for the /pathways map. Public (restrict it by referrer
# in Google Cloud).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
